{
	"name": "mmss-app",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "oxlint",
		"update-packages": "bunx npm-check-updates -u --workspaces && bun i",
		"update-packages-patch": "bunx npm-check-updates -u --target patch --workspaces && bun i",
		"update-packages-support": "bunx npm-check-updates -u --filter turbo,vite,posthog-js,posthog-node,typescript,@typescript/native,svelte-check,oxlint,oxfmt,@types/node,esbuild --workspaces && bun i",
		"skills": "bunx skills experimental_install",
		"format": "oxfmt"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"bun": {
		"overrides": {
			"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
		}
	},
	"devDependencies": {
		"@tsconfig/node24": "24.0.5",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"turbo": "^2.11.10",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.3.14"
}
