{
	"extends": "@tsconfig/node24/tsconfig",
	"compilerOptions": {
		"exactOptionalPropertyTypes": false,
		"inlineSourceMap": true,
		"inlineSources": true,
		"typeRoots": ["./node_modules/@types"],
		"allowSyntheticDefaultImports": true
	},
	"include": ["lib/**/*", "bin/**/*"],
	"exclude": ["node_modules", "cdk.out"]
}
